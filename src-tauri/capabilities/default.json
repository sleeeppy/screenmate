{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the overlay window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-ignore-cursor-events",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
